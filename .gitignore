# macOS
.DS_Store

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local environment files
.env
.env.*

# Jupyter notebooks
.ipynb_checkpoints/

# Packaging and build artifacts
build/
dist/
*.egg-info/

# Data generated or downloaded during experiments
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained models and checkpoints
models/*
!models/.gitkeep

# Generated report artifacts
reports/figures/*
!reports/figures/.gitkeep
reports/tables/*
!reports/tables/.gitkeep
